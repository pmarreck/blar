#!/usr/bin/env bash
set -u

if [[ -z ${IN_NIX_SHELL:-} ]]; then
    exec nix develop -c bash "$0" "$@"
fi

# Legacy fixture generators still need Python; fail before missing fixtures
# can turn empty-output comparisons into apparent passes.
if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' 'Legacy test fixtures require Python. Run: nix shell --inputs-from . nixpkgs#python3 -c ./test' >&2
    exit 1
fi

# =============================================================================
# BLIP Master Test Runner
# =============================================================================
# Runs the ENTIRE test suite: Zig unit tests + all CLI integration tests.
# Exit code = total number of failures across all suites.
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOTAL_FAIL=0
TOTAL_PASS=0

run_suite() {
    local name="$1"
    local cmd="$2"
    echo ""
    echo "━━━ $name ━━━"
    local output
    output=$(eval "$cmd" 2>&1)
    local rc=$?
    # Extract pass/fail counts if present
    local pass fail
    pass=$(printf '%s\n' "$output" | sed -nE \
        -e 's/.* ([0-9]+) passed.*/\1/p' \
        -e 's/.* ([0-9]+)\/[0-9]+ tests passed.*/\1/p' | head -1)
    fail=$(printf '%s\n' "$output" | sed -nE 's/.* ([0-9]+) failed.*/\1/p' | head -1)
    pass=${pass:-0}
    fail=${fail:-0}
    if [[ $rc -ne 0 && "$fail" == "0" ]]; then
        fail=1
    fi
    TOTAL_PASS=$((TOTAL_PASS + pass))
    TOTAL_FAIL=$((TOTAL_FAIL + fail))
    if (( rc != 0 )); then
        printf '%s\n' "$output"
    else
        printf 'Results: %s passed, %s failed\n' "$pass" "$fail"
    fi
}

echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                   BLIP Master Test Suite                    ║"
echo "╚══════════════════════════════════════════════════════════════╝"

# Build everything first (ReleaseFast for CLI tests)
echo ""
echo "Building (ReleaseFast)..."
build_output=$(./build 2>&1)
build_rc=$?
if (( build_rc != 0 )); then
    printf '%s\nFATAL: build failed\n' "$build_output"
    exit 1
fi

run_suite "Packaged CLI" "bash tests/cli/package_test"

# Zig unit tests
run_suite "Zig Unit Tests" "nix develop -c zig build test --summary all 2>&1"

# CLI integration test suites
run_suite "blar CLI Tests" "bash tests/blar_test.sh"
run_suite "Container Expansion (in-memory)" "bash tests/container_expansion_test.sh"
run_suite "Container Expansion (streaming)" "BLAR_STREAMING_THRESHOLD=0 bash tests/container_expansion_test.sh"
run_suite "PDF Container Tests" "bash tests/pdf_container_test.sh"
run_suite "PNG Container Tests" "bash tests/png_container_test.sh"
run_suite "Streaming Tests" "bash tests/streaming_test.sh"
run_suite "Compression Tests" "bash tests/compression_test.sh"
run_suite "Encryption Tests" "bash tests/encryption_test.sh"
run_suite "Segmentation Tests" "bash tests/segmentation_test.sh"

# Summary
echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║  TOTAL: $TOTAL_PASS passed, $TOTAL_FAIL failed"
echo "╚══════════════════════════════════════════════════════════════╝"

exit $TOTAL_FAIL
